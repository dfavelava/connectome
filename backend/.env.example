apikey="test"
MEMORY_MANAGER="local"
# POSTGRES_HOST is "postgres" to match the docker-compose service name on the
# container network. Use "localhost" when running the backend outside Docker
# against a locally published Postgres port.
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="fake-pass"
# POSTGRES_DB is also what the docker-compose postgres service (the official
# postgres/pgvector image) reads to name the database it creates on first boot.
POSTGRES_DB="postgres"
# For reference only (e.g. `psql "$POSTGRES_URL"`) - the backend itself builds
# its DSN from the POSTGRES_* values above rather than parsing this.
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
