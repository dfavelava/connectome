apikey="test"
MEMORY_MANAGER="local"
# S3_BUCKET is required when MEMORY_MANAGER=s3 - the bucket the S3 memory
# manager reads/writes objects in. Unused otherwise.
# S3_BUCKET="daybid-dev"
# POSTGRES_HOST is "postgres" to match the docker-compose service name on the
# container network. Use "localhost" when running the backend outside Docker
# against a locally published Postgres port.
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="fake-pass"
# POSTGRES_DB is also what the docker-compose postgres service (the official
# postgres/pgvector image) reads to name the database it creates on first boot.
POSTGRES_DB="postgres"
# For reference only (e.g. `psql "$POSTGRES_URL"`) - the backend itself builds
# its DSN from the POSTGRES_* values above rather than parsing this.
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# SEARCH_VECTOR_WEIGHT, SEARCH_TEXT_WEIGHT, and SEARCH_RRF_K tune how memory
# search blends vector similarity with full-text relevance (reciprocal-rank
# fusion - see backend/daos/embeddingsDao.go's HybridWeights). All three are
# optional; unset or unparsable values fall back to the defaults below.
# SEARCH_VECTOR_WEIGHT=0.6
# SEARCH_TEXT_WEIGHT=0.4
# SEARCH_RRF_K=60
# SEARCH_TEXT_QUERY picks how the full-text leg reads the query (see
# TextQueryMode in backend/daos/embeddingsDao.go): "plain" (default,
# plainto_tsquery - every term must match), "websearch"
# (websearch_to_tsquery), "or" (any term matches, ranked by ts_rank), or
# "and_or" (like "or", but chunks matching every term rank first). Unknown
# values fall back to "plain".
# SEARCH_TEXT_QUERY=plain
# DEFAULT_ACL is the comma-separated acl applied to a memory whose frontmatter
# omits acl entirely (see backend/resources/acl.go). Unset means unrestricted
# (no acl filtering) - the sane default for a generic instance. A deployment
# that wants writes restricted to a specific group by default would set, e.g.:
# DEFAULT_ACL=admins
# INDEX_CONCURRENCY caps how many memories are embedded at once (across all
# requests) and how many files one batch write processes at once (see
# backend/resources/memoryResource.go). Unset or non-positive falls back to 4.
# INDEX_CONCURRENCY=4
